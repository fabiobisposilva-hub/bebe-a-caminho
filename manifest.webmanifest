{
  "id": "./",
  "name": "BeBê a CaMinHo",
  "short_name": "BeBê a CaMinHo",
  "description": "O diário do seu bebê, da barriga em diante.",
  "lang": "pt-BR",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#F5F3ED",
  "theme_color": "#5F7F5A",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "./compartilhar",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "titulo",
      "text": "texto",
      "files": [
        {
          "name": "fotos",
          "accept": [
            "image/*",
            ".jpg",
            ".jpeg",
            ".png",
            ".heic",
            ".webp"
          ]
        }
      ]
    }
  }
}